{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fnox run api_dev -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@clerk/backend": "^3.4.1",
    "@corridor/db": "workspace:*",
    "@corridor/shared": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.5.0",
    "hono": "^4.7.7",
    "ioredis": "^5.6.1",
    "jose": "^6.2.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "plaid": "^42.1.0",
    "stripe": "^22.1.0",
    "svix": "^1.92.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
