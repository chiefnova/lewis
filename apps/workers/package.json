{
  "name": "workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fnox run -P workers_dev -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@corridor/db": "workspace:*",
    "@corridor/notifications": "workspace:*",
    "@corridor/pdf": "workspace:*",
    "@corridor/shared": "workspace:*",
    "bullmq": "^5.49.1",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
