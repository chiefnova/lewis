{
  "name": "patient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fnox run -P frontend_patient_dev -- vite --host 0.0.0.0 --port 13002 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 13002 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:a11y": "vitest run --passWithNoTests a11y"
  },
  "dependencies": {
    "@clerk/react": "^6.4.5",
    "@lewis/shared": "workspace:*",
    "@lewis/ui": "workspace:*",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.10",
    "react-router-dom": "^7.5.3",
    "vite": "^6.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "tailwindcss": "^4.1.0"
  }
}
