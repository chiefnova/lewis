tests/e2e/node_modules/

# === Claude Code ===
# CLAUDE.md and team-shared .claude/rules/ + .claude/commands/ ARE committed.
# Personal settings, lock files, and ephemeral project state are NOT.
.claude/settings.local.json
.claude/.lock
.claude/projects/
.gstack/

# === Codex CLI (local tool config, not project source) ===
.codex/
