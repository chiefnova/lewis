# === Environment + secrets ===
# fnox.toml IS committed — it holds age-encrypted secrets keyed to [[recipients]].
# Plaintext .env files and personal overrides are NOT.
# .env.example and .env.<app>.example ARE committed as templates.
.env
.env.*
!.env.example
!.env.*.example
*.age.bak
.fnox/

# === mise ===
# mise.toml IS committed. Per-user local overrides are not.
.mise.local.toml

# === Supabase CLI scratch files ===
supabase/.branches/
supabase/.temp/

# === Docker volumes (local) ===
postgres_data/
redis_data/

# === PHI and patient data — NEVER commit anything that could contain real patient info ===
# Generated PDFs from Puppeteer worker: patient agreements, AE reports, HFAR forms,
# ETRB annual reports, DPHHS annual reports, license application packages.
apps/workers/output/
apps/api/.data/
apps/api/scripts/output/
tmp/pdfs/
exports/
# Informed consent video/audio recordings (50-12-105(3)(b))
recordings/
tmp/recordings/
*.recording.webm
*.recording.mp4
# Patient fixture data
patient-fixtures/
*.phi.json
*.phi.csv

# === Sentry ===
.sentryclirc

# === IDE ===
.idea/
.vscode/
*.swp
*.swo
.mcp.json

# === OS ===
.DS_Store
Thumbs.db

