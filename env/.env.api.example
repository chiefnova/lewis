# ===========================================================================
# .env.api.example  —  env surface for apps/api (Hono API)
#
# WHAT      Reference list of every env var the API expects at runtime. Use it
#           as a checklist when configuring fnox locally or Railway in prod.
# DOCS ONLY This file is NOT loaded at runtime. The API gets its env from:
#             local dev → `fnox run -P api_dev -- tsx watch src/index.ts`
#             CI        → `fnox run -P ci -- …`
#             prod/stg  → Railway env vars
# SECRETS   Set provider keys with `fnox set --profile api_dev <KEY> <value>`
#           (encrypted in fnox.toml — see CLAUDE.md security #8).
# RLS       The API connects as the non-owner `app_api` DB role. SUPABASE_
#           SERVICE_ROLE_KEY is intentionally absent from this surface; per
#           CLAUDE.md security #1, no user-facing path may bypass RLS via
#           service-role. That key lives only in workers_elevated_dev.
# ===========================================================================

PORT=13001
NODE_ENV=development

# --- Database (RLS-bound application role; NEVER service-role) -----------
# The API connects as a low-privilege application role bound by RLS. Per
# CLAUDE.md security #1, no user-facing path may bypass RLS via service-role.
# The Supabase service-role key is intentionally NOT listed here — it lives
# only in the dedicated elevated-worker profile (.env.workers-elevated.example).
DATABASE_URL=postgres://app_api:lewis_app_api@127.0.0.1:15432/lewis_dev
MIGRATION_DATABASE_URL=postgres://lewis:lewis@127.0.0.1:15432/lewis_dev
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=lewis_dev
DB_USERNAME=app_api
DB_PASSWORD=lewis_app_api

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:16379
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# --- Clerk (auth + webhooks) ---------------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional: pin the verifyToken audience and authorized parties.
# CLERK_JWT_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=https://app.lewis.health,https://patient.lewis.health

# --- Webhook providers ---------------------------------------------------
# DEFERRED — Stripe (PRD § 14). Uncomment + fill once Stripe is onboarded.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DEFERRED — Plaid (PRD § 14.4). Uncomment + fill once Plaid is onboarded.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# DEFERRED — Resend (PRD § 13). Uncomment + fill once Resend domain is verified.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# --- Observability -------------------------------------------------------
# DEFERRED — Sentry (PRD § 18). Uncomment once Sentry projects exist.
# SENTRY_DSN=
LOG_LEVEL=debug

# --- Public surface -------------------------------------------------------
SUPABASE_URL=https://example.supabase.co
# Comma-separated list of origins permitted by CORS. Required (the boot will
# fail if missing in non-test environments).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000,http://127.0.0.1:13002,http://localhost:13002,http://127.0.0.1:13003,http://localhost:13003,https://lewis.health,https://www.lewis.health,https://app.lewis.health,https://patient.lewis.health
PUBLIC_API_BASE_URL=http://127.0.0.1:13001

# --- Other integrations --------------------------------------------------
# DEFERRED — Daily.co video/recording (PRD § 6 — Sprint 6).
# DAILY_API_KEY=
# DEFERRED — E-signature provider (PRD § 5 — Sprint 5).
# ESIGN_API_KEY=

# --- Runtime role enforcement (TEST ESCAPE HATCH) ------------------------
# The API asserts at startup that it is connected as the non-owner `app_api`
# DB role (i.e. RLS is on for this connection). Some unit tests boot without
# Postgres or against a sqlite/mock; they may set this to skip the assertion.
#
# WARNING: NEVER set in staging or production. CI gates this — if the var is
# present in any non-test env, the deploy fails. See apps/api/src/index.ts.
# API_RUNTIME_ROLE_OPT_OUT=true
