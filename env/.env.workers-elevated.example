# ===========================================================================
# .env.workers-elevated.example  —  env surface for the PRIVILEGED worker
#
# WHAT      Reference list for a SEPARATE worker process that needs to bypass
#           RLS for narrow privileged operations (Supabase Storage signed-URL
#           minting, cross-tenant indexers, system-wide compliance recomputes).
# DOCS ONLY Not loaded at runtime. The elevated worker gets its env from:
#             local dev → `fnox run -P workers_elevated_dev -- …`
#             prod/stg  → Railway env vars on a SEPARATE service
# SECRETS   `fnox set --profile workers_elevated_dev <KEY> <value>`. The
#           workers_elevated_dev profile has fewer recipients than api_dev.
#
# Hard rules (enforced in code review + CI):
#   - Runs as a different OS process from apps/api and apps/workers.
#   - apps/api/src and apps/workers/src MAY NOT read SUPABASE_SERVICE_ROLE_KEY.
#   - fnox.toml may expose SUPABASE_SERVICE_ROLE_KEY only through this profile.
#   - Handlers must:
#       1. Assert no user request context is active (no app.* session vars set).
#       2. Wrap every operation in a job audit row so the bypass is traceable.
#       3. Run from an explicit allowlist of jobs — no general-purpose API.
# ===========================================================================

NODE_ENV=production
LOG_LEVEL=info

# Database — still use an RLS-bound runtime role for user data. Service-role is
# only for the narrow non-Postgres bypass operations documented below.
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Service-role for Supabase Storage signed-URL minting and similar
# operations. Must be sourced from a fnox profile that has fewer
# recipients than the api_dev profile.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (job queue + idempotency cache shared with the API).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# Sentry uses a dedicated DSN so privileged-process errors are tagged
# distinctly in dashboards.
# DEFERRED — Sentry (PRD § 18). Uncomment once Sentry projects exist.
# SENTRY_DSN=

# --- Worker posture toggle (REQUIRED for this profile) -------------------
# Tells the worker startup assertion that this is the privileged process.
# Without this, the boot assertion expects `app_worker` and will refuse to
# start when it sees an elevated DB role / service-role key. Must be "true".
WORKER_ELEVATED=true
