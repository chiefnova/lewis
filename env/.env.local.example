# ===========================================================================
# .env.local.example  —  template for local-dev defaults
#
# WHAT      Non-secret defaults for local dev: DB/Redis URLs, ports, log level,
#           Vite public vars, CORS allowlist.
# COPY TO   .env.local at the repo root. (Plaintext .env files are gitignored.)
# LOADED BY mise — see mise.toml `_.file = ".env.local"`. Auto-loaded for every
#           `mise run …` task.
# SECRETS   This file holds NO real secrets. Provider keys (Clerk, Stripe, Plaid,
#           Resend, Supabase, Sentry, …) come from fnox profiles. Each app's
#           `pnpm dev` wraps in `fnox run -P <profile> -- …`:
#             apps/api      → api_dev
#             apps/workers  → workers_dev
#             apps/app      → frontend_app_dev
#             apps/patient  → frontend_patient_dev
#             (privileged)  → workers_elevated_dev
# PROD      Staging/prod values live in Vercel/Railway env vars only — never
#           in this file, never in fnox, never in the repo.
#
# Never put real secrets or PHI in .env.local.
# ===========================================================================

NODE_ENV=development
TZ=America/Denver
LOG_LEVEL=debug

PORT=13001
LOCAL_POSTGRES_PORT=15432
LOCAL_REDIS_PORT=16379

# Runtime DB connections use non-owner roles so local development exercises RLS.
# Migrations and seed use MIGRATION_DATABASE_URL; API uses DATABASE_URL; workers
# use WORKER_DATABASE_URL when set.
DATABASE_URL=postgres://app_api:corridor_app_api@127.0.0.1:15432/corridor_dev
WORKER_DATABASE_URL=postgres://app_worker:corridor_app_worker@127.0.0.1:15432/corridor_dev
MIGRATION_DATABASE_URL=postgres://corridor:corridor@127.0.0.1:15432/corridor_dev
REDIS_URL=redis://127.0.0.1:16379

# The runtime also supports DB_* and REDIS_* when DATABASE_URL/REDIS_URL are unset.
# DB_HOST=127.0.0.1
# DB_PORT=15432
# DB_DATABASE=corridor_dev
# DB_USERNAME=app_api
# DB_PASSWORD=corridor_app_api
# WORKER_DB_USERNAME=app_worker
# WORKER_DB_PASSWORD=corridor_app_worker
# MIGRATION_DB_USERNAME=corridor
# MIGRATION_DB_PASSWORD=corridor
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379

VITE_API_BASE_URL=http://127.0.0.1:13001/v1
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000,http://127.0.0.1:13002,http://localhost:13002
PUBLIC_API_BASE_URL=http://127.0.0.1:13001

# Scaffold worker processors are allowed only for local/test.
# Workers auto-enable stubs when NODE_ENV is development or test, so in normal
# local development you do NOT need to set this. The variable is ONLY honored
# outside production. In NODE_ENV=production it is ignored with a warning.
# Uncomment if you need stub processors during a one-off local debug session
# AND your NODE_ENV is not production:
# ENABLE_STUB_WORKERS=true

# --- TRAP: do NOT set CORRIDOR_SEED_ALLOW_NON_LOCAL ----------------------
# This variable looks like an escape hatch but is intentionally not one. The
# seed script (packages/db/scripts/seed-dev.ts) checks for it and fails fast
# when it is set, with a message explaining there is no override. Listed here
# so devs who stumble across it in source know its purpose without trying it.
