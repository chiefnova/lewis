# ===========================================================================
# .env.app.example  —  env surface for apps/app (staff/business console)
#
# WHAT      Vite-exposed env vars for app.lewis.health (manufacturer + ETC + admin).
# DOCS ONLY Not loaded at runtime. The app gets its env from:
#             local dev → `fnox run -P frontend_app_dev -- vite`
#             prod/stg  → Vercel env vars
# SECRETS   Only VITE_-prefixed keys reach the browser bundle (Vite convention).
#           Set with `fnox set --profile frontend_app_dev <KEY> <value>`.
#
# The patient portal has its own env surface (.env.patient.example) — separate
# Clerk app, Sentry DSN, deploy, and PHI exposure posture.
# ===========================================================================

VITE_API_BASE_URL=http://127.0.0.1:13001/v1
VITE_CLERK_PUBLISHABLE_KEY=
# DEFERRED — Stripe (PRD § 14). Uncomment + fill once Stripe is onboarded.
# VITE_STRIPE_PUBLISHABLE_KEY=
# DEFERRED — Sentry (PRD § 18). Uncomment once Sentry projects exist.
# VITE_SENTRY_DSN=
