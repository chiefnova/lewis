# ===========================================================================
# .env.workers.example  —  env surface for apps/workers (regular fleet)
#
# WHAT      Reference list of env vars the regular (RLS-bound) BullMQ worker
#           process expects.
# DOCS ONLY Not loaded at runtime. Workers get their env from:
#             local dev → `fnox run -P workers_dev -- tsx watch src/index.ts`
#             prod/stg  → Railway env vars
# SECRETS   Set with `fnox set --profile workers_dev <KEY> <value>`.
# RLS       Regular workers connect as the non-owner `app_worker` DB role and
#           are RLS-bound. Privileged work that needs service-role lives in a
#           SEPARATE process — see .env.workers-elevated.example.
# ===========================================================================

NODE_ENV=development
LOG_LEVEL=debug

# Regular workers run as a low-privilege non-owner DB role. They are RLS-bound
# and do not receive service-role/admin credentials.
WORKER_DATABASE_URL=postgres://app_worker:lewis_app_worker@127.0.0.1:15432/lewis_dev
MIGRATION_DATABASE_URL=postgres://lewis:lewis@127.0.0.1:15432/lewis_dev
WORKER_DB_HOST=127.0.0.1
WORKER_DB_PORT=15432
WORKER_DB_DATABASE=lewis_dev
WORKER_DB_USERNAME=app_worker
WORKER_DB_PASSWORD=lewis_app_worker

REDIS_URL=redis://127.0.0.1:16379
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

CLERK_SECRET_KEY=
# DEFERRED — Stripe (PRD § 14). Uncomment + fill once Stripe is onboarded.
# STRIPE_SECRET_KEY=
# DEFERRED — Resend (PRD § 13). Uncomment + fill once Resend domain is verified.
# RESEND_API_KEY=
# DEFERRED — Sentry (PRD § 18). Uncomment once Sentry projects exist.
# SENTRY_DSN=

# Stub processors are enabled automatically for NODE_ENV=development/test.
# Production ignores this flag by design.
# ENABLE_STUB_WORKERS=true

# --- Worker posture toggles ----------------------------------------------
# WORKER_ELEVATED selects which DB role this worker process expects. The
# regular fleet (this file) MUST be unset or "false" — the worker boots as
# `app_worker` (RLS-bound, NOBYPASSRLS). The privileged process sets this
# to "true" and runs from .env.workers-elevated. Mismatch = boot failure.
# WORKER_ELEVATED=false

# --- Runtime role enforcement (TEST ESCAPE HATCH) ------------------------
# Workers assert at startup that they are connected as the expected non-owner
# DB role. Tests that boot against a mock/sqlite may set this to skip.
#
# WARNING: NEVER set in staging or production. CI gates this — if present in
# any non-test env, the deploy fails. See apps/workers/src/index.ts.
# WORKER_RUNTIME_ROLE_OPT_OUT=true
