# ===========================================================================
# .env.patient.example  —  env surface for apps/patient (patient portal)
#
# WHAT      Vite-exposed env vars for patient.corridor.health.
# DOCS ONLY Not loaded at runtime. The patient app gets its env from:
#             local dev → `fnox run -P frontend_patient_dev -- vite`
#             prod/stg  → Vercel env vars
# SECRETS   Only VITE_-prefixed keys reach the browser bundle.
#           Set with `fnox set --profile frontend_patient_dev <KEY> <value>`.
#
# The patient portal is intentionally a separate product from apps/app: own
# Clerk app, Sentry DSN, deploy, accessibility/a11y review, and HIPAA/PHI
# exposure surface. Keep its env config separate from frontend_app_dev.
# ===========================================================================

VITE_API_BASE_URL=http://127.0.0.1:13001/v1
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
