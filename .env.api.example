PORT=13001
NODE_ENV=development

# --- Database (RLS-bound application role; NEVER service-role) -----------
# The API connects as a low-privilege application role bound by RLS. Per
# CLAUDE.md security #1, no user-facing path may bypass RLS via service-role.
# The Supabase service-role key is intentionally NOT listed here — it lives
# only in the dedicated elevated-worker profile (.env.workers-elevated.example).
DATABASE_URL=postgres://corridor:corridor@127.0.0.1:15432/corridor_dev
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=corridor_dev
DB_USERNAME=corridor
DB_PASSWORD=corridor

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:16379
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# --- Clerk (auth + webhooks) ---------------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional: pin the verifyToken audience and authorized parties.
# CLERK_JWT_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=https://app.corridor.health,https://patient.corridor.health

# --- Webhook providers ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Observability -------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# --- Public surface -------------------------------------------------------
SUPABASE_URL=https://example.supabase.co
# Comma-separated list of origins permitted by CORS. Required (the boot will
# fail if missing in non-test environments).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.corridor.health,https://patient.corridor.health
PUBLIC_API_BASE_URL=http://127.0.0.1:13001

# --- Other integrations --------------------------------------------------
DAILY_API_KEY=
ESIGN_API_KEY=
