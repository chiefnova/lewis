{
  "name": "lewis",
  "version": "0.0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm run dev:infra && pnpm run dev:all",
    "dev:infra": "docker compose up -d --wait postgres redis",
    "dev:api": "pnpm --filter api dev",
    "dev:workers": "pnpm --filter workers dev",
    "dev:app": "pnpm --filter app dev",
    "dev:patient": "pnpm --filter patient dev",
    "dev:directory": "pnpm --filter directory dev",
    "dev:all": "pnpm -r --parallel --stream --filter app --filter patient --filter directory --filter api --filter workers dev",
    "dev:down": "docker compose down",
    "db:migrate": "pnpm --filter @lewis/db migrate:local",
    "db:seed": "pnpm --filter @lewis/db seed",
    "contracts:openapi:check": "node scripts/check-openapi-route-drift.mjs",
    "config:local-defaults:check": "node scripts/check-local-defaults.mjs",
    "secrets:profiles:check": "node scripts/check-fnox-secret-boundaries.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "echo \"e2e tests scaffold pending Sprint 4\"",
    "test:a11y": "pnpm -r --if-present test:a11y",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.32",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "axe-core": "^4.10.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
