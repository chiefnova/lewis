# ===========================================================================
# Elevated worker profile (.env.workers-elevated)
#
# This profile is for a SEPARATE worker process that needs to bypass RLS to
# perform privileged operations (e.g. minting Supabase Storage signed URLs,
# running cross-tenant indexers, system-wide compliance recomputes).
#
# It MUST run as a different OS process from apps/api and the regular
# apps/workers fleet. Code in apps/api/src or apps/workers/src is forbidden
# from reading SUPABASE_SERVICE_ROLE_KEY (CI gate enforces).
#
# When the elevated worker lands, its handlers must:
#   1. Assert no user request context is active (no app.* session vars set).
#   2. Wrap every operation in a job audit row so the bypass is traceable.
#   3. Run with explicit allowlist of allowed jobs — no general-purpose API.
# ===========================================================================

NODE_ENV=production
LOG_LEVEL=info

# Database — same RLS-bound role as everywhere else for user data, plus
# the service-role key for the narrow set of bypass operations.
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Service-role for Supabase Storage signed-URL minting and similar
# operations. Must be sourced from a fnox profile that has fewer
# recipients than the api_dev profile.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (job queue + idempotency cache shared with the API).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

# Sentry uses a dedicated DSN so privileged-process errors are tagged
# distinctly in dashboards.
SENTRY_DSN=
