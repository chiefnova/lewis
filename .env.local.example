# Copy to .env.local for local development defaults.
# Keep real secrets out of plaintext env files; use fnox for provider secrets.

NODE_ENV=development
TZ=America/Denver
LOG_LEVEL=debug

PORT=13001
LOCAL_POSTGRES_PORT=15432
LOCAL_REDIS_PORT=16379
DATABASE_URL=postgres://corridor:corridor@127.0.0.1:15432/corridor_dev
REDIS_URL=redis://127.0.0.1:16379

# The runtime also supports DB_* and REDIS_* when DATABASE_URL/REDIS_URL are unset.
# DB_HOST=127.0.0.1
# DB_PORT=15432
# DB_DATABASE=corridor_dev
# DB_USERNAME=corridor
# DB_PASSWORD=corridor
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379

VITE_API_BASE_URL=http://127.0.0.1:13001/v1
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# Scaffold worker processors are allowed only for local/test.
# Workers auto-enable stubs when NODE_ENV is development or test, so in normal
# local development you do NOT need to set this. The variable is ONLY honored
# outside production. In NODE_ENV=production it is ignored with a warning.
# Uncomment if you need stub processors during a one-off local debug session
# AND your NODE_ENV is not production:
# ENABLE_STUB_WORKERS=true
